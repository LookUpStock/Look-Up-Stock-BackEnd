type Query {
    "Anlagensuche wie GET /assets/search; ohne Anmeldung. limit 1 bis 25, Standard 10"
    searchAssets(query: String!, limit: Int): [Asset!]!

    "Eigene Portfolios, neueste zuerst; Anmeldung erforderlich"
    portfolios: [Portfolio!]!

    "Ein eigenes Portfolio; fremde oder unbekannte ID liefert NOT_FOUND (NF-04)"
    portfolio(id: ID!): Portfolio

    "Eigene gespeicherte Simulationen, neueste zuerst; Anmeldung erforderlich"
    savedSimulations: [SavedSimulation!]!

    "Eine eigene gespeicherte Simulation; fremde oder unbekannte ID liefert NOT_FOUND (NF-04)"
    savedSimulation(id: ID!): SavedSimulation
}

type Asset {
    id: ID!
    symbol: String!
    isin: String
    name: String
    exchange: String
    micCode: String
    currency: String
    type: String
}

type Portfolio {
    id: ID!
    name: String!
    "Zeitpunkt im Format ISO-8601 (UTC)"
    createdAt: String!
    updatedAt: String
    positions: [Position!]!
}

type Position {
    assetId: ID!
    symbol: String!
    name: String
    "Gewichtung in Prozent"
    weight: Float!
}

type SavedSimulation {
    id: ID!
    name: String!
    portfolioId: ID!
    createdAt: String!
    "Wird nur geladen, wenn die Abfrage das Feld anfordert"
    portfolio: Portfolio
    "Kennzahlen aus US-05; werden nur geladen, wenn die Abfrage das Feld anfordert"
    metrics: Metrics
}

type Metrics {
    totalContributions: Float!
    medianEndValue: Float!
    p5EndValue: Float!
    p95EndValue: Float!
    valueAtRisk95: Float!
    "Anteil, z. B. 0.31 = 31 %"
    maxDrawdownMedian: Float!
    "null ohne Zielbetrag"
    targetProbability: Float
}

# Input fields are optional on purpose so missing values produce the same messages as REST instead of a generic GraphQL error.

type Mutation {
    "Portfolio anlegen wie POST /portfolios (US-03)"
    createPortfolio(input: PortfolioInput!): Portfolio!

    "Eigenes Portfolio ändern wie PUT /portfolios/{id} (US-06)"
    updatePortfolio(id: ID!, input: PortfolioInput!): Portfolio!

    "Eigenes Portfolio löschen wie DELETE /portfolios/{id} (US-06); true bei Erfolg"
    deletePortfolio(id: ID!): Boolean!

    "Simulation rechnen wie POST /simulations (US-04); mit save: true zusätzlich speichern (US-08)"
    simulate(input: SimulationInput!): SimulationResult!

    "Gespeicherte Simulation löschen wie DELETE /simulations/{id} (US-08); true bei Erfolg"
    deleteSavedSimulation(id: ID!): Boolean!

    "Zwei Einträge vergleichen wie POST /comparisons (US-07)"
    compare(input: ComparisonInput!): ComparisonResult!
}

input PortfolioInput {
    name: String
    positions: [PositionInput]
}

input PositionInput {
    assetId: ID
    "Gewichtung in Prozent, Summe aller Positionen 100"
    weight: Float
}

input SimulationParametersInput {
    startCapital: Float
    monthlyContribution: Float
    "1 bis 40 ganze Jahre"
    horizonYears: Int
    "1.000 bis 50.000, Standard 10.000"
    paths: Int
    "Ohne Seed wird einer erzeugt und im Ergebnis zurückgegeben (NF-08); exakt bis 2^53"
    seed: Float
    targetAmount: Float
}

input SimulationInput {
    portfolioId: ID
    parameters: SimulationParametersInput
    "true = Ergebnis zusätzlich speichern; dann ist name Pflicht"
    save: Boolean
    name: String
}

input ComparisonItemInput {
    label: String
    "Genau eines von portfolioId und assetId"
    portfolioId: ID
    assetId: ID
}

input ComparisonInput {
    items: [ComparisonItemInput]
    parameters: SimulationParametersInput
}

type SimulationResult {
    "null, wenn nicht gespeichert"
    id: ID
    name: String
    portfolioId: ID!
    parameters: SimulationParameters!
    estimates: Estimates!
    timeline: [TimelinePoint!]!
    metrics: Metrics!
    runtimeMs: Float!
    createdAt: String
}

type SimulationParameters {
    startCapital: Float!
    monthlyContribution: Float!
    horizonYears: Int!
    paths: Int!
    seed: Float!
    targetAmount: Float
}

type Estimates {
    "Erster und letzter Monat des Schätzzeitraums (ISO-8601)"
    historyFrom: String!
    historyTo: String!
    assets: [AssetEstimate!]!
}

type AssetEstimate {
    assetId: ID!
    annualReturn: Float!
    annualVolatility: Float!
}

type TimelinePoint {
    "Monat ab Start, beginnend bei 0"
    month: Int!
    p5: Float!
    p50: Float!
    p95: Float!
}

type ComparisonResult {
    parameters: SimulationParameters!
    estimates: Estimates!
    results: [ComparisonItem!]!
    pairwise: [PairwiseComparison!]!
    runtimeMs: Float!
    createdAt: String
}

type ComparisonItem {
    label: String!
    portfolioId: ID
    assetId: ID
    timeline: [TimelinePoint!]!
    metrics: Metrics!
}

type PairwiseComparison {
    a: Int!
    b: Int!
    "Anteil der Pfade, in denen Eintrag a am Ende mehr wert ist als Eintrag b"
    probabilityAOutperformsB: Float!
}
