# Vorlage fuer lokale Umgebungsvariablen des core-service.
# Nur Platzhalter, keine echten Zugangsdaten eintragen!
# Echte Werte gehoeren in eine .env (wird nicht committet).

# Port, auf dem der core-service laeuft (Standard: 8080)
PORT=8080

# Frontend-Adressen, die das Backend aufrufen duerfen (kommagetrennt)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Datenbankverbindungsinformationen (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/lookupstock
DB_USERNAME=postgres
DB_PASSWORD=dein-passwort

# marktdaten-service (lokal auf Port 8081) und gemeinsamer Schluessel, auf beiden Seiten gleich
MARKTDATEN_URL=http://localhost:8081
INTERNAL_API_KEY=lokaler-test-schluessel
