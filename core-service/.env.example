# Template for local environment variables. Placeholders only; real values go into .env (not committed).

PORT=8080

# Frontend origins allowed to call the backend (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

DB_URL=jdbc:postgresql://localhost:5432/lookupstock
DB_USERNAME=postgres
DB_PASSWORD=dein-passwort

# Must match INTERNAL_API_KEY of the marktdaten-service
MARKTDATEN_URL=http://localhost:8081
INTERNAL_API_KEY=lokaler-test-schluessel
