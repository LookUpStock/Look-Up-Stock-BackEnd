# Vorlage fuer lokale Umgebungsvariablen des marktdaten-service.
# Nur Platzhalter, keine echten Zugangsdaten eintragen!
# Echte Werte gehoeren in eine .env (wird nicht committet).

# Port des marktdaten-service (der core-service laeuft lokal auf 8080)
PORT=8081

# Dieselbe Datenbank wie der core-service; Tabellen liegen im Schema marktdaten
DB_URL=jdbc:postgresql://localhost:5432/lookupstock
DB_USERNAME=postgres
DB_PASSWORD=dein-passwort

# API-Key fuer Twelve Data (nur hier, nicht mehr im core-service)
TWELVE_DATA_API_KEY=dein-twelve-data-key

# Gemeinsamer Schluessel mit dem core-service (Header X-Internal-Api-Key), auf beiden Seiten gleich
INTERNAL_API_KEY=lokaler-test-schluessel
