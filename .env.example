# Vorlage fuer lokale Umgebungsvariablen des Backends.
# Nur Beispielwerte, keine echten Zugangsdaten eintragen!
# Echte Werte gehoeren in eine .env (wird nicht committet).

# Port, auf dem das Backend laeuft (Standard: 8080)
PORT=8080

# Frontend-Adressen, die das Backend aufrufen duerfen (kommagetrennt)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Datenbankverbindungsinformationen (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/V1_portfolio.sql
DB_USERNAME=username
DB_PASSWORD=password